# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg

# Models (downloaded at runtime)
models/*.onnx
models/*.tflite
models/*.pth
models/*.task
!models/.gitkeep

# Logs
logs/*.jsonl
logs/*.json
logs/*.log
!logs/.gitkeep

# Research data (sensitive — may contain face images)
data/captures/*
data/annotations/*
data/protocol/*.jpg
data/protocol/*.png
data/ar_dataset/
data/calibration/
!data/captures/.gitkeep
!data/annotations/.gitkeep

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Working notes
initial-prompt.txt
# Derived sub-protocol directories — built from data/in_house/ on demand
data/in_house_replay/
data/in_house_clean/

# Phase F separability dataset — per-session amispoof JSON dumps. These
# carry user_agent (browser fingerprint) + raw biometric session telemetry
# and are inherently personal; commit the notebook + analysis artefacts,
# never the raw dumps. Keep the folder with a .gitkeep so the notebook's
# folder-discovery logic still finds the directory.
notebooks/data/*.json
!notebooks/data/.gitkeep

# amispoof vendor bundle — onnxruntime-web + @mediapipe/tasks-vision copied
# from node_modules at build time (`npm run amispoof:bundle`). 80+ MB binary
# WASM blobs; not source code. Regenerate locally; do not commit.
web/amispoof/vendor/
